<Page x:Class="Aplicacio.Pagines.Administradors_Trajectes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
xmlns:pages="clr-namespace:Aplicacio.Pagines"
xmlns:windows="clr-namespace:Aplicacio.Finestres"
      xmlns:local="clr-namespace:Aplicacio.Pagines"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Administradors_Trajectes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <ui:NavigationView x:Name="RootNavigation" 
               PaneDisplayMode="Top"  OpenPaneLength="220"
                IsBackButtonVisible="Collapsed" FrameMargin="0" Grid.Row="0">
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem TargetPageType="{x:Type pages:Consultors}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PersonArrowBack20" FontSize="18"></ui:SymbolIcon>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <StackPanel Margin="32, 16" Grid.Row="1">
            <Label Content="Trajectes"
                   HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"/>
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Label Content="Usuari creador:"
                       Grid.Column="0" Grid.Row="0"/>
                <TextBox Grid.Column="0" Grid.Row="1"
                         Width="200" HorizontalAlignment="Left"
                         x:Name="txbUsuari"/>
                <CheckBox Content="Validats" HorizontalAlignment="Right"
                          Grid.Column="1" Grid.Row="1" IsChecked="True"
                          x:Name="chbValidats"/>
            </Grid>

            <ListView x:Name="lsvTrajectes" Margin="20" Height="200">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{Binding Nom}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
