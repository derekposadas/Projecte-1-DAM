<Page x:Class="Aplicacio.Pagines.Editors"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:pages="clr-namespace:Aplicacio.Pagines"
      xmlns:windows="clr-namespace:Aplicacio.Finestres"
      xmlns:local="clr-namespace:Aplicacio.Pagines"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Editors"
      Loaded="Page_Loaded">

    <StackPanel Margin="32, 16">
        <Label Content="Trajectes creats"
        FontWeight="SemiBold" FontSize="26" HorizontalAlignment="Right" Margin="0,0,80,0"/>
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20">
                <Button Content="Modificar"
                Background="Yellow" BorderBrush="Black" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="10"
                x:Name="btnModificar" Click="btnModificar_Click" IsEnabled="False"/>
                <Button Content="Eliminar"
                Background="Red" BorderBrush="Black" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" Margin="10"
                x:Name="btnEliminar" Click="btnEliminar_Click" IsEnabled="False"/>
                <Button Content="Crear nou trajecte"
                Background="LimeGreen" BorderBrush="Black" FontWeight="SemiBold" FontSize="22" HorizontalAlignment="Right" Margin="10"
                x:Name="btnCrear" Click="btnCrear_Click"/>
            </StackPanel>

            <ListView x:Name="lsvTrajectes" Height="200" Grid.Column="1" SelectionChanged="lsvTrajectes_SelectionChanged">

            </ListView>
        </Grid>
    </StackPanel>
</Page>
