<Page x:Class="Aplicacio.Pagines.Consultors"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Aplicacio.Pagines"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Consultors"
      Loaded="Page_Loaded">

    <StackPanel Margin="32, 26">
        <Label Content="Consulta trajectes" FontSize="32" FontWeight="Bold" Margin="0,0,0,25"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <Label Content="Origen: " Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right"/>
                <TextBox x:Name="txbOrigen" Grid.Column="1" Grid.Row="0"
                         Width="160" HorizontalAlignment="Left" Margin="10,0,0,0"
                         />

                <Label Content="Destí: " Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"/>
                <TextBox x:Name="txbDesti" Grid.Row="1" Grid.Column="1"
                         Width="160" HorizontalAlignment="Left" Margin="10,0,0,0"
                             />
            </Grid>
            <StackPanel Grid.Column="0" Margin="10">
                <StackPanel Orientation="Horizontal" Margin="5">
                    
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Hora sortida:" />
                <TextBox x:Name="txbHoraSortida"
                         Width="200"/>
            </StackPanel>
        </Grid>

        <Label Content="Resultats" FontSize="28" FontWeight="SemiBold" Margin="0,30,0,0"/>
    </StackPanel>
</Page>
