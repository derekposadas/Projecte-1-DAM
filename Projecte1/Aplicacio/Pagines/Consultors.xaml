<Page x:Class="Aplicacio.Pagines.Consultors"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Aplicacio.Pagines"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Consultors"
      Loaded="Page_Loaded">

    <StackPanel Margin="32, 26">
        <Label Content="Consulta trajectes" FontSize="32" FontWeight="Bold" Margin="0,0,0,25"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <Label Content="Origen: " Grid.Column="0" Grid.Row="0" 
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       />
                <TextBox x:Name="txbOrigen" Grid.Column="1" Grid.Row="0"
                         Width="160" HorizontalAlignment="Left" Margin="10"
                         TextChanged="txb_TextChanged"
                         />
                <Popup x:Name="popupOrigen"
                       PlacementTarget="{Binding ElementName=txtOrigen}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">

                    <Border Background="White"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Width="{Binding ActualWidth, ElementName=txtOrigen}"
                            MaxHeight="150">

                        <ListBox x:Name="lstOrigen"
                             SelectionChanged="lstOrigen_SelectionChanged"
                             BorderThickness="0"
                             DisplayMemberPath="Nom"/>
                    </Border>
                </Popup>

                <Label Content="Destí: " Grid.Row="1" Grid.Column="0" 
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="txbDesti" Grid.Row="1" Grid.Column="1"
                         Width="160" HorizontalAlignment="Left" Margin="10"
                         TextChanged="txb_TextChanged"
                             />
            </Grid>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Hora sortida:" />
                    <TextBox x:Name="txbHoraSortida"
                         Width="200"
                         TextChanged="txb_TextChanged"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <GroupBox Header="Resultats" FontSize="26" Margin="10">
            <ListView x:Name="lsvTrajectes">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>
        
    </StackPanel>
</Page>
