<Page x:Class="Aplicacio.Pagines.EditarTrajecte"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:pages="clr-namespace:Aplicacio.Pagines"
      xmlns:windows="clr-namespace:Aplicacio.Finestres"
      xmlns:local="clr-namespace:Aplicacio.Pagines"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditarTrajecte"
      Loaded="Page_Loaded">

    <StackPanel Margin="32, 16">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Content="Dades del trajecte" FontSize="32" FontWeight="SemiBold"
                   Grid.Column="0"/>
            <Button Content="Afegir trajecte" Background="LimeGreen" FontWeight="SemiBold"
                    Grid.Column="1" HorizontalAlignment="Right"
                    x:Name="btnAfegirTrajecte" Click="btnAfegirTrajecte_Click"/>
        </Grid>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Content="Nom del trajecte:" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Grid.Column="0" Grid.Row="0"/>
            <Label Content="Mitjà de transport:" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Grid.Column="0" Grid.Row="1"/>

            <TextBox HorizontalAlignment="Stretch" Margin="5"
                     Grid.Column="1" Grid.Row="0"
                     x:Name="txbNomTrajecte"/>
            <TextBox HorizontalAlignment="Stretch" Margin="5"
                     Grid.Column="1" Grid.Row="1"
                     x:Name="txbMitjaTransport"/>
        </Grid>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Label Content="Dades de les parades" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Label Content="Nom:" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Grid.Column="0" Grid.Row="0"/>
                    <Label Content="Hora de pas:" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Grid.Column="0" Grid.Row="1"/>
                    <Label Content="Estació:" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Grid.Column="0" Grid.Row="2"/>

                    <TextBox Margin="5" HorizontalAlignment="Stretch"
                             Grid.Column="1" Grid.Row="0"
                             x:Name="txbNomParada"/>
                    <TextBox Margin="5" HorizontalAlignment="Stretch"
                             Grid.Column="1" Grid.Row="1"
                             x:Name="txbHoraPas"/>
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="2" Margin="5">
                        <TextBox HorizontalAlignment="Stretch"
                                 x:Name="txbEstacioParada"/>

                    </StackPanel>
                </Grid>

                <Button Content="Afegir parada" Background="LimeGreen" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="10"
                        x:Name="btnAfegirParada" Click="btnAfegirParada_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <ListView x:Name="lsvParades" Height="140" Margin="10" SelectionChanged="lsvParades_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="{Binding Ordre}"/>
                                <Label Content=" - "/>
                                <Label Content="{Binding Nom}"/>
                                <Label Content=" "/>
                                <Label Content="{Binding HoraPas}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                    <Button Content="Eliminar" Background="Red" Foreground="White" FontWeight="SemiBold" Margin="5"
                            x:Name="btnEliminarParada" Click="btnEliminarParada_Click" IsEnabled="False"/>
                    <Button Content="Modificar" Background="Yellow" FontWeight="SemiBold" Margin="5"
                            x:Name="btnModificarParada" Click="btnModificarParada_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</Page>
