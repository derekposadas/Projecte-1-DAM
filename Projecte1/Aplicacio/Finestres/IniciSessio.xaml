<Window x:Class="Aplicacio.Finestres.IniciSessio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:Aplicacio.Pagines"
        xmlns:windows="clr-namespace:Aplicacio.Finestres"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aplicacio.Finestres"
        mc:Ignorable="d"
        Title="Iniciar sessió" Height="394" Width="644"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <ui:NavigationView x:Name="RootNavigation" 
                   PaneDisplayMode="Top"  OpenPaneLength="220"
                    IsBackButtonVisible="Collapsed" FrameMargin="0" Grid.Row="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem TargetPageType="{x:Type pages:Consultors}" NavigationCacheMode="Enabled">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home16" FontSize="18"></ui:SymbolIcon>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem TargetPageType="{x:Type windows:IniciSessio}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Person12" FontSize="18"></ui:SymbolIcon>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <StackPanel Margin="32, 16" Grid.Row="1">
            <Button Content="Registra't" 
                    Background="Blue" Foreground="White" FontWeight="SemiBold" BorderBrush="Black" Margin="20"
                    x:Name="btnRegistrat" Click="btnRegistrat_Click"/>
            
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.6*"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label Content="Email" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" FontSize="22" HorizontalAlignment="Right" Margin="10"/>
                <TextBox x:Name="txbEmail" Grid.Row="0" Grid.Column="1" Width="300" HorizontalAlignment="Left"/>

                <Label Content="Contrasenya" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" FontSize="22" HorizontalAlignment="Right" Margin="10"/>
                <TextBox x:Name="txbContrasenya" Grid.Row="1" Grid.Column="1" Width="300" HorizontalAlignment="Left"/>
            </Grid>

            <Button Content="Inicia sessió"
                    Background="Yellow" Foreground="Black" FontWeight="SemiBold" BorderBrush="Black" 
                    Margin="20" HorizontalAlignment="Center"
                    x:Name="btnIniciaSessio" Click="btnIniciaSessio_Click"/>

            <Label Content="Usuari o contrasenya incorrectes"
                   Foreground="Red" FontWeight="SemiBold" HorizontalAlignment="Center" Visibility="Hidden"
                   x:Name="lblIncorrecte"/>
        </StackPanel>
    </Grid>
</Window>
