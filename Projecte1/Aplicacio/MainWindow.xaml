<Window x:Class="Aplicacio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:Aplicacio.Pagines"
        xmlns:windows="clr-namespace:Aplicacio.Finestres"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aplicacio"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
   
        
        <ui:NavigationView x:Name="RootNavigation" 
                           PaneDisplayMode="Top"  OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed" FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="navConsultors" 
                                       TargetPageType="{x:Type pages:Consultors}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home16" FontSize="18"></ui:SymbolIcon>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="navCancel"
                                       Click="navCancel_Click"
                                       Visibility="Collapsed">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="18"></ui:SymbolIcon>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="navLogin" 
                                       Click="navLogin_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Person12" FontSize="18"></ui:SymbolIcon>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="navLogout"
                                       Click="navLogout_Click"
                                       Visibility="Collapsed">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PersonArrowBack20" FontSize="18"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</Window>
